# Training image — CUDA + PyTorch + PEFT/TRL/bitsandbytes.
# Build:  docker build -f docker/Dockerfile.train -t cs-tone-train .
# Run:    docker run --gpus all -v $PWD:/app -e WANDB_API_KEY cs-tone-train \
#            python -m src.training.train --config config.yaml

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3-pip git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
ENTRYPOINT ["python3.11"]
CMD ["-m", "src.training.train", "--config", "config.yaml"]
